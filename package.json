{
	"name": "optimizely-cloudflare-worker-template",
	"description": "A template for kick starting a Cloudflare Workers project with Optimizely",
	"version": "2.0.0",
	"license": "Apache-2.0",
	"type": "module",
	"main": "src/index.js",
	"private": true,
	"scripts": {
		"format": "biome format --write ./src ./test",
		"lint": "biome check --write ./src ./test",
		"dev": "miniflare src/index.js --wrangler --env development",
		"start": "miniflare src/index.js --wrangler",
		"test": "vitest run",
		"build": "npx wrangler deploy --dry-run --outdir dist"
	},
	"dependencies": {
		"@optimizely/optimizely-sdk": "^6.1.0",
		"cookie": "^1.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"miniflare": "^4.20250917.0",
		"vitest": "^3.2.4",
		"vitest-environment-miniflare": "^2.14.4"
	}
}
